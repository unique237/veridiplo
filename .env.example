# Copy to .env (git-ignored). Secrets live here only.

# --- Host ports (change if they clash) ---
API_PORT=8000
UI_PORT=8501
KG_PORT=7878
DB_PORT=5434
OLLAMA_PORT=11434

# --- Database ---
POSTGRES_USER=veridiplo
POSTGRES_PASSWORD=veridiplo
POSTGRES_DB=veridiplo

# --- Behaviour ---
POLICY_MODE=on            # on = Version B (governed), off = Version A (ungoverned)
LLM_PROVIDER=none         # none | ollama | anthropic | openai (cloud = cross-border transfer warning)
SEED=42
UI_DEFAULT_LANG=fr
EMBED_MODEL=intfloat/multilingual-e5-small

# --- Optional LLM backends (leave empty for offline demo) ---
OLLAMA_MODEL=qwen2.5:3b-instruct
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Host user id for bind-mounted files (run `id -u`) ---
APP_UID=1000
