# VeriDiplo Streamlit UI (lean: talks to the api over HTTP).
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_DEFAULT_TIMEOUT=60 \
    PIP_RETRIES=10 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    STREAMLIT_BROWSER_GATHER_USAGE_STATS=false

ARG APP_UID=1000
RUN useradd --create-home --uid ${APP_UID} --shell /bin/bash app \
    && mkdir -p /app && chown app:app /app
WORKDIR /app

COPY requirements-ui.txt /tmp/requirements-ui.txt
RUN --mount=type=cache,target=/root/.cache/pip pip install -r /tmp/requirements-ui.txt

COPY --chown=app:app ui /app/ui
USER app

EXPOSE 8501
CMD ["streamlit", "run", "ui/streamlit_app.py", "--server.port=8501", "--server.address=0.0.0.0", "--server.headless=true"]
